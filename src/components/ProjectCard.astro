---
import { Image } from "astro:assets";
import type { Project } from "../data";

type Props = {
  project: Project;
  eager?: boolean;
};

const { project, eager = false } = Astro.props;
---

<a
  href={project.href}
  target='_blank'
  rel='noopener noreferrer'
  class='group relative flex h-full flex-col overflow-hidden rounded-lg border border-border bg-surface transition-all duration-400 before:absolute before:-inset-px before:z-10 before:rounded-[inherit] before:bg-[linear-gradient(135deg,rgba(255,255,255,0.1)_0%,transparent_50%,rgba(255,255,255,0.05)_100%)] before:opacity-0 before:transition-opacity before:duration-300 before:content-[""] hover:before:opacity-100 after:absolute after:inset-0 after:rounded-[inherit] after:shadow-[0_0_40px_rgba(255,255,255,0.03)] after:opacity-0 after:transition-opacity after:duration-500 after:content-[""] hover:after:opacity-100'
>
  <div class='relative aspect-video overflow-hidden bg-surface-inset'>
    <Image
      src={project.imageSrc}
      alt={project.title}
      width={project.imageWidth}
      height={project.imageHeight}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      fetchpriority={eager ? "high" : undefined}
      class='absolute inset-0 h-full w-full object-cover opacity-90 transition-all duration-400 ease-out group-hover:opacity-100'
    />
  </div>
  <div class='flex grow flex-col p-4'>
    <h3
      class='font-medium transition-colors duration-300 group-hover:text-accent'
    >
      {project.title}
    </h3>
    <p class='mt-1 grow text-sm leading-relaxed text-muted'>
      {project.description}
    </p>
    <div class='mt-3 flex flex-wrap gap-2'>
      {
        project.tech.map((t) => (
          <span class='rounded bg-surface-hover px-2 py-0.5 font-mono text-xs text-muted'>
            {t}
          </span>
        ))
      }
    </div>
  </div>
</a>
