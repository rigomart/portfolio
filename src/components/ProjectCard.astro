---
import { Image } from "astro:assets";
import type { Project } from "../data";

type Props = {
  project: Project;
  eager?: boolean;
};

const { project, eager = false } = Astro.props;
---

<a
  href={project.href}
  target='_blank'
  rel='noopener noreferrer'
  class='card-glow group flex h-full flex-col overflow-hidden rounded-lg border border-border bg-surface transition-all duration-500 hover:-translate-y-0.5'
>
  <div class='relative aspect-video overflow-hidden bg-surface-inset'>
    <Image
      src={project.imageSrc}
      alt={project.title}
      width={project.imageWidth}
      height={project.imageHeight}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      fetchpriority={eager ? "high" : undefined}
      class='absolute inset-0 h-full w-full object-cover opacity-90 transition-all duration-700 ease-out group-hover:scale-[1.03] group-hover:opacity-100'
    />
  </div>
  <div class='flex grow flex-col p-4'>
    <h3
      class='font-medium transition-colors duration-300 group-hover:text-accent'
    >
      {project.title}
    </h3>
    <p class='mt-1 grow text-sm leading-relaxed text-muted'>
      {project.description}
    </p>
    <div class='mt-3 flex flex-wrap gap-2'>
      {
        project.tech.map((t) => (
          <span class='rounded bg-surface-hover px-2 py-0.5 font-mono text-xs text-muted'>
            {t}
          </span>
        ))
      }
    </div>
  </div>
</a>
