---
import { Image } from "astro:assets";
import type { Project } from "../data";
import ExternalLink from "./icons/ExternalLink.astro";
import Github from "./icons/Github.astro";

type Props = {
  project: Project;
  featured?: boolean;
  priority?: boolean;
};

const { project, featured = false, priority = false } = Astro.props;
---

<div
  class:list={[
    "group relative overflow-hidden rounded-md border border-border transition-all duration-300 hover:border-muted/50",
    featured ? "aspect-video sm:aspect-21/9" : "aspect-4/3",
  ]}
>
  <Image
    src={project.imageSrc}
    alt={project.title}
    priority={priority}
    layout='full-width'
    class='h-full w-full object-cover object-top opacity-70 transition-opacity duration-200 group-hover:opacity-90'
  />
  <div class='absolute inset-x-0 bottom-0 bg-linear-to-t from-background via-background to-transparent px-5 pb-4 pt-12'>
    <div class='flex items-start justify-between gap-3'>
      <h3 class='font-medium'>
        <a
          href={project.links.demo}
          target='_blank'
          rel='noopener noreferrer'
          class='text-foreground transition-colors hover:text-accent'
        >
          {project.title}
        </a>
      </h3>
      <div class='flex shrink-0 gap-2'>
        <a
          href={project.links.repo}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`${project.title} on GitHub`}
          class='text-muted transition-colors hover:text-foreground'
        >
          <Github />
        </a>
        <a
          href={project.links.demo}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={`${project.title} live demo`}
          class='text-muted transition-colors hover:text-foreground'
        >
          <ExternalLink />
        </a>
      </div>
    </div>
    <p
      class='mt-1 text-[13px] leading-relaxed text-muted line-clamp-3'
      title={project.description}
    >
      {project.description}
    </p>
    <p class='mt-2 font-mono text-[11px] text-foreground/40'>
      {project.tech.join(" · ")}
    </p>
  </div>
</div>
