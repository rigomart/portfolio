 ---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const socialLinks = [
  {
    name: "Email",
    href: "mailto:mirdor.dev@gmail.com",
  },
  {
    name: "GitHub",
    href: "https://github.com/rigomart",
  },
  {
    name: "LinkedIn",
    href: "https://linkedin.com/in/you",
  },
];
---

<div class={`flex items-center gap-2 ${className}`}>
  {
    socialLinks.map((link) => (
      <a
        href={link.href}
        target={link.name !== "Email" ? "_blank" : undefined}
        rel={link.name !== "Email" ? "noopener noreferrer" : undefined}
        class='flex items-center justify-center rounded-md text-muted transition-all duration-200 ease-in-out hover:bg-surface-hover hover:text-foreground hover:shadow-[0_0_4px_rgba(255,255,255,0.3)]'
        aria-label={link.name}
      >
        <span class="px-2 py-1">{link.name}</span>
      </a>
    ))
  }
</div>
