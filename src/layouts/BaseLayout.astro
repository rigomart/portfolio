---
import "../styles/global.css";
import { Font } from "astro:assets";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Miguel Rodriguez | Senior Frontend Engineer",
  description = "Senior Frontend Engineer with 4+ years focused on React, Next.js, and TypeScript. Specializing in migrating legacy systems to modern stacks and shipping under tight constraints.",
} = Astro.props;
---

<!doctype html>
<html lang='en' class='dark'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='description' content={description} />
    <meta name='generator' content={Astro.generator} />
    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='canonical' href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable='--font-open-sans' preload />
    <title>{title}</title>

    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property='og:image' content='/og-image-placeholder.png' />
    <meta property='og:image:alt' content='Miguel Rodriguez Portfolio' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content='/og-image-placeholder.png' />

    <script
      type='application/ld+json'
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Miguel Rodriguez",
        jobTitle: "Senior Frontend Engineer",
        url: "https://github.com/rigomart",
        description: description,
        knowsAbout: [
          "TypeScript",
          "React",
          "Next.js",
          "Tailwind CSS",
          "Node.js",
          "PostgreSQL",
          "GraphQL",
          "Frontend Architecture",
          "Microfrontends",
          "Module Federation",
          "Convex",
          "TanStack Query",
          "Drizzle",
          "CI/CD",
        ],
        sameAs: ["https://github.com/rigomart"],
      })}
    />
  </head>
  <body class='relative min-h-screen'>
    <slot />
  </body>
</html>
