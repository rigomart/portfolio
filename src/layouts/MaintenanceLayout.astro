---
// Standalone maintenance notice.
//
// Deliberately self-contained: it imports no global styles, no data from
// `src/data`, no fonts and no components from the portfolio itself, so the
// build ships nothing but this document while the site is down.
//
// To bring the site back: see MAINTENANCE.md in the repo root.
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='robots' content='noindex, nofollow' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <title>Under maintenance</title>
    <style>
      :root {
        color-scheme: dark;
        --background: #0c0c0c;
        --foreground: #e5e5e5;
        --muted: #737373;
        --border: #262626;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 2rem 1.5rem;
        background: var(--background);
        color: var(--foreground);
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
          "Liberation Mono", "Courier New", monospace;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 32rem;
      }

      .status {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--muted);
      }

      .dot {
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 50%;
        background: currentColor;
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.25;
        }
      }

      h1 {
        margin: 1.5rem 0 0;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      p {
        margin: 0.75rem 0 0;
        font-size: 0.875rem;
        color: var(--muted);
      }

      footer {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        font-size: 0.75rem;
        color: var(--muted);
      }

      a {
        color: var(--foreground);
        text-decoration: none;
        border-bottom: 1px solid var(--border);
        transition: border-color 0.2s ease;
      }

      a:hover {
        border-color: var(--muted);
      }

      @media (prefers-reduced-motion: reduce) {
        .dot {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <div class='status'>
        <span class='dot'></span>
        <span>Under maintenance</span>
      </div>

      <h1>Back shortly.</h1>

      <p>This site is being rebuilt. Nothing to see here for the moment.</p>

      <footer>
        Miguel Rodriguez &middot;
        <a href='mailto:mirdor.dev@gmail.com'>mirdor.dev@gmail.com</a>
      </footer>
    </main>
  </body>
</html>
