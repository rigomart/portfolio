---
export const prerender = false;

import ExperienceItem from "../components/ExperienceItem.astro";
import GithubActivity from "../components/GithubActivity.astro";
import GithubActivitySkeleton from "../components/GithubActivitySkeleton.astro";
import ArrowRight from "../components/icons/ArrowRight.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { experiences, projects } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class='relative mx-auto max-w-4xl px-6 py-16 sm:py-24'>
    <header class='mb-8 animate-fade-in-blur'>
      <div
        class='flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between'
      >
        <h1 class='text-3xl font-semibold tracking-tighter sm:text-4xl'>
          Miguel Rodriguez
        </h1>
        <SocialLinks />
      </div>
      <p class='mt-2 font-mono text-sm text-muted'>Full Stack Engineer</p>
    </header>

    <section class='mb-12 animate-fade-in-blur delay-100'>
      <p class='text-lg leading-relaxed text-foreground/90'>
        I build full-stack applications with a strong focus on frontend.
        Shipping pragmatically with type-safe foundations, intuitive UI, and
        maintainable systems. Lately I’ve been exploring linguistics/phonetics
        and AI-assisted developer workflows.
      </p>
    </section>

    <div class='mb-12 animate-fade-in-blur delay-150'>
      <GithubActivity server:defer>
        <GithubActivitySkeleton slot='fallback' />
      </GithubActivity>
    </div>

    <section class='mb-12 animate-fade-in-blur delay-200'>
      <h2
        class='mb-6 font-mono text-xs font-medium uppercase tracking-widest text-muted'
      >
        Projects
      </h2>
      <div class='grid gap-6 sm:grid-cols-2'>
        {
          projects.map((project, index) => (
            <div
              class='flex animate-fade-in-blur'
              style={`animation-delay: ${100 + index * 100}ms`}
            >
              <ProjectCard project={project} eager={index < 4} />
            </div>
          ))
        }
      </div>

      <div class='mt-8 flex justify-center'>
        <a
          href='https://github.com/rigomart'
          target='_blank'
          rel='noopener noreferrer'
          class='group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-foreground'
        >
          <span>See more on GitHub</span>
          <ArrowRight
            class='transition-transform duration-300 group-hover:translate-x-1'
          />
        </a>
      </div>
    </section>

    <section class='mb-12 animate-fade-in-blur delay-300'>
      <h2
        class='mb-6 font-mono text-xs font-medium uppercase tracking-widest text-muted'
      >
        Experience
      </h2>
      <div class='relative border-border flex flex-col'>
        {
          experiences.map((experience, index) => (
            <div
              class='animate-fade-in-blur'
              style={`animation-delay: ${500 + index * 100}ms`}
            >
              <ExperienceItem experience={experience} />
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <div
    class='bg-lines pointer-events-none absolute bottom-0 left-0 -z-10 h-[50vh] w-full'
  >
  </div>
</BaseLayout>
