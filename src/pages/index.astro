---
import ExperienceItem from "../components/ExperienceItem.astro";
import GithubActivity from "../components/GithubActivity.astro";
import ArrowRight from "../components/icons/ArrowRight.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { experiences, projects } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class='relative mx-auto max-w-4xl px-6 py-16 sm:py-24'>
    <header class='mb-8 animate-fade-in-blur'>
      <div
        class='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'
      >
        <!-- Left Column: Identity -->
        <div class='flex flex-col gap-2'>
          <h1 class='text-2xl font-semibold tracking-tighter sm:text-4xl'>
            Miguel Rodriguez
          </h1>
          <p class='font-mono text-sm text-muted'>Full Stack Engineer</p>
          <div class='mt-1'>
            <SocialLinks />
          </div>
        </div>

        <!-- Right Column: Activity -->
        <a
          href='https://github.com/rigomart'
          target='_blank'
          rel='noopener noreferrer'
          class='hidden sm:block opacity-40 hover:opacity-100 transition-opacity'
          aria-label='View GitHub Profile'
        >
          <GithubActivity weeks={30} />
        </a>
      </div>
    </header>

    <section class='mb-12 animate-fade-in-blur delay-100'>
      <p class='text-base leading-relaxed text-foreground/90'>
        I’m a Full Stack Engineer who loves bridging product design with systems
        thinking. My work revolves around shipping pragmatic, resilient
        applications where user experience meets code quality. Lately, I’ve been
        exploring the intersection of web development, phonetics, and AI.
      </p>
    </section>

    <section class='mb-12 animate-fade-in-blur delay-200'>
      <h2
        class='mb-6 font-mono text-xs font-medium uppercase tracking-widest text-muted'
      >
        Projects
      </h2>
      <div class='grid gap-6 sm:grid-cols-2'>
        {
          projects.map((project, index) => (
            <div
              class='flex animate-fade-in-blur'
              style={`animation-delay: ${100 + index * 100}ms`}
            >
              <ProjectCard project={project} eager={index < 4} />
            </div>
          ))
        }
      </div>

      <div class='mt-8 flex justify-center'>
        <a
          href='https://github.com/rigomart'
          target='_blank'
          rel='noopener noreferrer'
          class='group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-foreground'
        >
          <span>See more on GitHub</span>
          <ArrowRight
            class='transition-transform duration-300 group-hover:translate-x-1'
          />
        </a>
      </div>
    </section>

    <section class='mb-12 animate-fade-in-blur delay-300'>
      <h2
        class='mb-6 font-mono text-xs font-medium uppercase tracking-widest text-muted'
      >
        Experience
      </h2>
      <div class='relative border-border flex flex-col'>
        {
          experiences.map((experience, index) => (
            <div
              class='animate-fade-in-blur'
              style={`animation-delay: ${500 + index * 100}ms`}
            >
              <ExperienceItem experience={experience} />
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <div
    class='bg-lines pointer-events-none absolute bottom-0 left-0 -z-10 h-[50vh] w-full'
  >
  </div>
</BaseLayout>
