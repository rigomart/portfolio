---
import ExperienceItem from "../components/ExperienceItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { experiences, projects } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class='relative mx-auto max-w-4xl px-6 py-16 sm:py-24'>
    <header class='mb-8 animate-in fade-in slide-in-from-bottom-4 duration-700'>
      <h1 class='text-2xl font-medium tracking-tight'>Miguel Rodriguez</h1>
      <p class='mt-1 text-muted'>Full Stack Engineer</p>
    </header>

    <section
      class='mb-12 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-100'
    >
      <p class='mb-6 text-foreground/90 leading-relaxed'>
        I build full-stack applications with a strong focus on frontend.
        Shipping pragmatically with type-safe foundations, intuitive UI, and
        maintainable systems. Lately I’ve been exploring linguistics/phonetics
        and AI-assisted developer workflows.
      </p>
      <div class='flex gap-3 text-sm'>
        <a
          href='mirdor.dev@gmail.com'
          class='group inline-flex items-center gap-1 rounded-full border border-border bg-surface px-3 py-1 transition-colors hover:border-accent hover:text-accent'
          >Email</a
        >
        <a
          href='https://github.com/rigomart'
          target='_blank'
          rel='noopener noreferrer'
          class='group inline-flex items-center gap-1 rounded-full border border-border bg-surface px-3 py-1 transition-colors hover:border-accent hover:text-accent'
        >
          GitHub
        </a>
        <a
          href='https://linkedin.com/in/you'
          target='_blank'
          rel='noopener noreferrer'
          class='group inline-flex items-center gap-1 rounded-full border border-border bg-surface px-3 py-1 transition-colors hover:border-accent hover:text-accent'
        >
          LinkedIn
        </a>
      </div>
    </section>

    <section
      class='mb-12 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-200'
    >
      <h2
        class='mb-6 font-mono text-xs font-medium uppercase tracking-widest text-muted'
      >
        Projects
      </h2>
      <div class='grid gap-6 sm:grid-cols-2'>
        {
          projects.map((project, index) => (
            <div
              class='animate-in fade-in slide-in-from-bottom-4 duration-500'
              style={`animation-delay: ${300 + index * 100}ms; animation-fill-mode: both;`}
            >
              <ProjectCard project={project} eager={index < 4} />
            </div>
          ))
        }
      </div>
    </section>

    <section
      class='mb-12 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300'
    >
      <h2
        class='mb-6 font-mono text-xs font-medium uppercase tracking-widest text-muted'
      >
        Experience
      </h2>
      <div class='relative border-border flex flex-col'>
        {
          experiences.map((experience) => (
            <ExperienceItem experience={experience} />
          ))
        }
      </div>
    </section>
  </main>

  <div
    class='bg-lines pointer-events-none absolute bottom-0 left-0 -z-10 h-[50vh] w-full'
  >
  </div>
</BaseLayout>
